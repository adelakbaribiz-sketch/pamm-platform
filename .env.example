# Copy to .env (Docker Compose) and/or backend/.env (local backend). Placeholder values only.
# Docker Compose service hostnames are used below; for a local backend use localhost,
# or sqlite:///./pamm_demo.db for the zero-dependency demo mode.
DATABASE_URL=postgresql+psycopg://pamm:pamm_dev_pw@postgres:5432/pamm
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start with a weak secret when ENVIRONMENT=production.
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=7

ENVIRONMENT=development
LOG_LEVEL=INFO

# Tenant whose strategies appear on the public marketplace endpoints (/api/public/*)
DEFAULT_TENANT=demo-broker
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 0 to skip generating the 26-week SIMULATED demo track record during `python -m app.seed`
SEED_DEMO_HISTORY=1
